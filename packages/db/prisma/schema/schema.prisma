generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id
  name           String
  lastName       String
  email          String   @unique
  hashedPassword String
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("users")
}
