generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id
  name           String
  lastName       String
  email          String   @unique
  hashedPassword String
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  avatar         String?

  personalProjects     Project[] @relation("PersonalProjects")
  sharedWithMeProjects Project[] @relation("SharedWithMeProjects")
  updatedProjects      Project[] @relation("UpdatedProjects")

  @@map("users")
}

model Project {
  id        String   @id
  name      String
  fileId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdById String
  createdBy   User @relation("PersonalProjects", fields: [createdById], references: [id])

  updatedById String
  updatedBy   User @relation("UpdatedProjects", fields: [updatedById], references: [id])

  sharedWith User[] @relation("SharedWithMeProjects")

  @@map("projects")
}