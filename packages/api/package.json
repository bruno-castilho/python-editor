{
  "name": "@python-editor/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./test/*": {
      "default": "./test/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@python-editor/db": "*",
    "@python-editor/env": "*",
    "@python-editor/mailer": "*",
    "@python-editor/redis": "*",
    "@python-editor/s3": "*",
    "@python-editor/schemas": "*",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "@types/geoip-lite": "^1.4.4",
    "@types/ua-parser-js": "^0.7.39",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.2",
    "geoip-lite": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@python-editor/config": "*",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.5"
  }
}
