    "@python-editor/schemas": "*",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@python-editor/config": "*",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.5"
